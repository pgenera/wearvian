# Copy this file to `keystore.properties` (gitignored) and fill in real values.
# Use the SAME keystore + key for BOTH the watch and companion apps — the Wear Data
# Layer requires a matching signature, and Play uses one signing key per listing.
# See docs/play-store-packaging.md.

storeFile=/absolute/path/to/wearvian-upload.jks
storePassword=CHANGE_ME
keyAlias=wearvian
keyPassword=CHANGE_ME
