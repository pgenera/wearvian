<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Marks this bundle as the Wear OS form factor so Play delivers it to watches
         (and the phone bundle, which lacks this feature, to phones). -->
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- BLE: we connect to a known device by name and never derive physical
         location, so we assert neverForLocation and avoid the location permission. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Keep BLE presence alive while the app is in use (foreground only). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep the CPU running so the presence heartbeat keeps streaming with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".WearvianApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wearvian">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Ambient (always-on) support: AmbientLifecycleObserver drives our custom idle screen
             via the platform-provided com.google.android.wearable library. -->
        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Wearvian">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.PresenceService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- "Off" action on the presence notification: disarm the key + stop the service. -->
        <receiver
            android:name=".service.KeyOffReceiver"
            android:exported="false" />

        <!-- Re-arm the key (start presence) after an app upgrade, so it comes back ACTIVE without
             opening the app. Gated on keyArmed inside the receiver. -->
        <receiver
            android:name=".service.UpgradeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Quick lock/unlock/key tile. Lock/unlock run in-process (no app UI);
             the key control launches MainActivity. -->
        <service
            android:name=".tile.KeyTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_tile_preview" />
        </service>

        <!-- Watch-face complication: battery state-of-charge (arc + %). Pushed on change by
             ComplicationRefresher; UPDATE_PERIOD_SECONDS=0 means no system polling. -->
        <service
            android:name=".complication.SocComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication_battery"
            android:label="@string/complication_soc_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- Watch-face complication: estimated remaining range (localized mi/km). -->
        <service
            android:name=".complication.RangeComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication_range"
            android:label="@string/complication_range_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

    </application>
</manifest>
