<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Marks this bundle as the Wear OS form factor so Play delivers it to watches
         (and the phone bundle, which lacks this feature, to phones). -->
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <!-- Passive mode wakes us via CompanionDeviceManager presence observation (optional —
         the app works without it; only auto power-save needs it). -->
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />

    <!-- BLE: we connect to a known device by name and never derive physical
         location, so we assert neverForLocation and avoid the location permission. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Keep BLE presence alive while the app is in use (foreground only). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep the CPU running so the presence heartbeat keeps streaming with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Passive mode: let CompanionDeviceManager observe the phone key's presence and
         cold-start our foreground service when it appears (FGS-start allowlisted). -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wearvian">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Wearvian">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.PresenceService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Bound by the OS when the associated phone key comes into range while we idle
             passively; cold-starts PresenceService (FGS-start allowlisted). -->
        <service
            android:name=".service.VehiclePresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- "Off" action on the presence notification: disarm the key + stop the service. -->
        <receiver
            android:name=".service.KeyOffReceiver"
            android:exported="false" />

        <!-- Quick lock/unlock/key tile. Lock/unlock run in-process (no app UI);
             the key control launches MainActivity. -->
        <service
            android:name=".tile.KeyTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_tile_key" />
        </service>

    </application>
</manifest>
